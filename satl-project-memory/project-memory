#!/usr/bin/env bash
# project-memory — dependency-free helper for a satl-project-memory store.
#
# The store is plain markdown and is fully hand-maintainable; this script only
# removes the mechanical parts (id allocation, index regeneration, drift check).
# Nothing here is required for the skill to work — every command has a
# hand-editing equivalent, which is why the script never owns any state that
# isn't recoverable by re-reading the chunks.
#
# Store shape:
#   .ai/memory/INDEX.md          generated  — newest-first, one row per chunk
#   .ai/memory/FILES.md          generated  — reverse index, path -> chunk ids
#   .ai/memory/YYYY-MM-DD/NN-slug.md        — immutable chunks
#
# Invariant the whole script rests on: chunks are the only source of truth.
# Both indexes are derived, so any bug here is repaired by re-running `index`,
# never by hand-patching a generated file.
#
# Usage: project-memory <command> [args]   (run `project-memory help`)

set -euo pipefail

# --- constants -------------------------------------------------------------

# Store location relative to the project root. Stated once here; override for a
# single invocation with MEMORY_DIR (used by the test suite for isolation).
readonly STORE_REL=".ai/memory"

# The two generated files. Named constants because they are referenced from
# find-exclusions, writers, and the drift check — a literal in any one of those
# places silently desynchronises it from the others.
readonly INDEX_FILE="INDEX.md"
readonly FILES_FILE="FILES.md"

# Chunk types accepted by `new`. Closed set — mirrors the table in SKILL.md.
readonly VALID_TYPES="decision gotcha convention state failed-attempt map external"

# Frontmatter keys read by this script. The chunk schema is a closed set defined
# in SKILL.md; these constants are the single place the script names it, so a
# schema rename is one edit rather than a grep-and-hope.
readonly FM_ID="id"
readonly FM_TYPE="type"
readonly FM_TITLE="title"
readonly FM_TAGS="tags"
readonly FM_FILES="files"
readonly FM_STATUS="status"

# Defaults stamped into a new chunk. `active` is the only status a chunk may be
# born with — `superseded`/`expired` are outcomes, never initial states.
readonly DEFAULT_STATUS="active"
# `medium` not `high`: a chunk is unverified until its author fills in Evidence,
# so defaulting to `high` would launder guesses into facts.
readonly DEFAULT_CONFIDENCE="medium"

# Chunk path grammar. The date-dir pattern is what makes reverse lexicographic
# order equal reverse chronological order, so it is load-bearing for INDEX.md.
readonly CHUNK_DIR_PATTERN='^[0-9]{4}-[0-9]{2}-[0-9]{2}/'
readonly CHUNK_FILE_GLOB='[0-9][0-9]-*.md'
# Sequence numbers are two digits so that 02 sorts after 01 as text; a day would
# need >99 chunks to overflow, which would mean the write bar had collapsed.
readonly SEQ_FORMAT='%02d'
# Slug cap keeps filenames comfortably inside path limits once the date dir and
# NN prefix are added, while staying long enough to stay human-readable.
readonly SLUG_MAX_CHARS=60

# Placeholder for an absent value in a generated table cell. An em dash rather
# than an empty cell so a missing field is visibly missing, not overlooked.
readonly EMPTY_CELL="—"

# Marker written into generated files so a human knows not to hand-edit them.
readonly GEN_MARKER="<!-- generated by \`project-memory index\` — do not edit by hand -->"

# --- helpers ---------------------------------------------------------------

# Abort with a message on stderr. Every failure path routes through here so the
# command name always prefixes the error, whatever the caller's context.
die() { printf 'project-memory: %s\n' "$1" >&2; exit 1; }

# Resolve the store path: explicit MEMORY_DIR wins, else walk up from cwd to the
# nearest existing store, else fall back to the git root, else cwd.
#
# Why the upward walk: chunks get written from wherever the agent happens to be
# working, which is rarely the repo root. Without it, running the script from a
# subdirectory would silently create a second store there.
#
# Invariant: always prints a path, never fails — callers check for existence
# themselves so they can emit a command-specific "run init first" message.
store_dir() {
  if [ -n "${MEMORY_DIR:-}" ]; then printf '%s\n' "$MEMORY_DIR"; return; fi
  local dir="$PWD"
  while [ "$dir" != "/" ]; do
    [ -d "$dir/$STORE_REL" ] && { printf '%s\n' "$dir/$STORE_REL"; return; }
    dir=$(dirname "$dir")
  done
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null || printf '%s' "$PWD")
  printf '%s\n' "$root/$STORE_REL"
}

# Turn a chunk title into a filename slug: lowercase, non-alphanumerics collapsed
# to single dashes, trimmed, capped. Lossy by design — the full title lives in
# frontmatter, and the filename only has to be readable and collision-resistant.
slugify() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -e 's/[^a-z0-9]\{1,\}/-/g' -e 's/^-//' -e 's/-$//' \
    | cut -c1-"$SLUG_MAX_CHARS"
}

# Print `key<TAB>value` for every frontmatter key in the chunk at $1.
#
# Deliberately not a YAML parser: it reads only the leading `---` block and
# splits on the first colon, so a colon inside a title survives intact. List
# values have their brackets stripped, so `[a, b]` reaches callers as `a, b`.
frontmatter() {
  awk '
    NR == 1 && $0 == "---" { inside = 1; next }
    inside && $0 == "---"  { exit }
    inside {
      idx = index($0, ":")
      if (idx == 0) next
      key = substr($0, 1, idx - 1)
      val = substr($0, idx + 1)
      gsub(/^[ \t]+|[ \t]+$/, "", key)
      gsub(/^[ \t]+|[ \t]+$/, "", val)
      gsub(/^\[|\]$/, "", val)
      printf "%s\t%s\n", key, val
    }
  ' "$1"
}

# Read one frontmatter field ($2) from a chunk ($1); empty string if absent.
# Absence is normal (`supersedes:` and `until:` are usually blank), so this
# never errors — callers substitute their own default.
field() {
  frontmatter "$1" | awk -F'\t' -v k="$2" '$1 == k { print $2; exit }'
}

# Print every chunk path relative to the store, newest first.
#
# The date-dir filter is what excludes stray markdown (a README someone drops in
# the store, the generated indexes) without maintaining a second exclusion list.
# `|| true` because an empty store is a valid state, not an error, and grep
# exits 1 when it matches nothing.
chunk_paths() {
  local store="$1"
  find "$store" -type f -name '*.md' \
    ! -name "$INDEX_FILE" ! -name "$FILES_FILE" \
    | sed "s|^$store/||" \
    | grep -E "$CHUNK_DIR_PATTERN" \
    | LC_ALL=C sort -r || true
}

# --- commands --------------------------------------------------------------

# Create the store and its two (empty) generated files. Safe to re-run: existing
# files are left alone, so this never destroys a populated store.
cmd_init() {
  local store; store=$(store_dir)
  mkdir -p "$store"
  [ -f "$store/$INDEX_FILE" ] || : > "$store/$INDEX_FILE"
  [ -f "$store/$FILES_FILE" ] || : > "$store/$FILES_FILE"
  cmd_index
  printf 'initialised store at %s\n' "$store"
}

# Create today's next chunk from the template and print its path.
#
# Only allocates the id and scaffolds the body — the caller (agent or human)
# fills in the prose plus `tags:` and `files:`. `files:` in particular is what
# feeds FILES.md, so a chunk left with `files: []` is indexed but invisible at
# the moment it would matter most.
cmd_new() {
  local type="${1:-}" title="${2:-}"
  [ -n "$type" ] && [ -n "$title" ] || die 'usage: project-memory new <type> "<title>"'
  case " $VALID_TYPES " in
    *" $type "*) ;;
    *) die "unknown type '$type' (valid: $VALID_TYPES)" ;;
  esac

  local store day dir seq id slug path
  store=$(store_dir)
  day=$(date +%F)
  dir="$store/$day"
  mkdir -p "$dir"

  # Next sequence number for today: highest existing NN, incremented.
  # `10#` forces base 10 — without it bash reads the zero-padded `08`/`09` as
  # octal and errors out, which would break the store on exactly two days a month.
  seq=$(find "$dir" -maxdepth 1 -name "$CHUNK_FILE_GLOB" 2>/dev/null \
        | sed 's|.*/||; s|-.*||' | LC_ALL=C sort -r | head -1)
  seq=$(printf "$SEQ_FORMAT" $(( 10#${seq:-0} + 1 )))

  id="$day-$seq"
  slug=$(slugify "$title")
  path="$dir/$seq-$slug.md"
  [ -e "$path" ] && die "chunk already exists: $path"

  cat > "$path" <<EOF
---
$FM_ID: $id
date: $day
$FM_TYPE: $type
$FM_TITLE: $title
$FM_TAGS: []
$FM_FILES: []
$FM_STATUS: $DEFAULT_STATUS
confidence: $DEFAULT_CONFIDENCE
supersedes:
until:
---

**What** — <the fact, one line>

**Why** — <the reason it is this way — never omit>

**How** — <the mechanism or exact fix, with file:line>

**Evidence** — <command, error string, PR link — how this was verified>

**Don't** — <the thing that looks right but isn't — never omit>
EOF

  printf '%s\n' "$path"
}

# Rebuild both generated files from chunk frontmatter.
#
# Idempotent and total: it truncates and rewrites rather than patching, so a
# corrupted or hand-mangled index is repaired by running this. That is also why
# nothing else in the script ever appends to an index.
cmd_index() {
  local store; store=$(store_dir)
  [ -d "$store" ] || die "no store at $store (run: project-memory init)"

  local idx="$store/$INDEX_FILE" files="$store/$FILES_FILE" pairs
  pairs=$(mktemp)
  # Note: this EXIT trap replaces any trap an outer caller set. Safe today
  # because cmd_check is the only internal caller and sets none.
  # shellcheck disable=SC2064  # expand $pairs now, not at trap time
  trap "rm -f '$pairs'" EXIT

  {
    printf '# Memory index\n\n%s\n\n' "$GEN_MARKER"
    printf 'Newest first. Read this at session start; open a chunk only when it looks relevant.\n\n'
    printf '| id | type | title | tags | status |\n|---|---|---|---|---|\n'
  } > "$idx"

  local rel abs id type title tags status f
  # `<<<` rather than a pipe: a piped `while` runs in a subshell, and the loop
  # must stay in this shell so the collected pairs and locals survive it.
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    abs="$store/$rel"
    # Fall back per field rather than skipping the chunk: a malformed chunk must
    # still appear in the index, or it becomes invisible and unfixable.
    id=$(field "$abs" "$FM_ID");         id=${id:-${rel%%/*}-??}
    type=$(field "$abs" "$FM_TYPE");     type=${type:-$EMPTY_CELL}
    title=$(field "$abs" "$FM_TITLE");   title=${title:-$(basename "$rel" .md)}
    tags=$(field "$abs" "$FM_TAGS");     tags=${tags:-$EMPTY_CELL}
    status=$(field "$abs" "$FM_STATUS"); status=${status:-$DEFAULT_STATUS}
    printf '| [%s](%s) | %s | %s | %s | %s |\n' "$id" "$rel" "$type" "$title" "$tags" "$status" >> "$idx"

    # Collect `path<TAB>id` pairs for the reverse index.
    printf '%s\n' "$(field "$abs" "$FM_FILES")" | tr ',' '\n' | while IFS= read -r f; do
      f=$(printf '%s' "$f" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^"//' -e 's/"$//')
      # `if`, not `&&` — a chunk with an empty `files:` list would otherwise
      # end the loop body on a false test and abort the script under `set -e`.
      if [ -n "$f" ]; then printf '%s\t%s\n' "$f" "$id" >> "$pairs"; fi
    done
  done <<< "$(chunk_paths "$store")"

  {
    printf '# Memory reverse index\n\n%s\n\n' "$GEN_MARKER"
    printf 'Grep this for a path (and its parent dirs) BEFORE editing that file, then read the chunks it names.\n\n'
    printf '| path | chunks |\n|---|---|\n'
    if [ -s "$pairs" ]; then
      # Collapse the sorted pairs so each path gets exactly one row listing every
      # chunk that names it — several chunks about one file is the common case.
      LC_ALL=C sort -u "$pairs" | awk -F'\t' '
        $1 != prev { if (prev != "") printf "| %s | %s |\n", prev, ids; prev = $1; ids = $2; next }
        { ids = ids ", " $2 }
        END { if (prev != "") printf "| %s | %s |\n", prev, ids }
      '
    fi
  } > "$files"

  printf 'wrote %s and %s\n' "$idx" "$files"
}

# Exit non-zero if the indexes had drifted from the chunks. For CI or a
# pre-commit hook.
#
# Deliberately self-healing rather than read-only: it regenerates and compares,
# so a failing run leaves the tree correct and the fix is `git add`. A pure check
# would report the problem and still require the user to run `index` by hand.
cmd_check() {
  local store before_idx before_files
  store=$(store_dir)
  [ -f "$store/$INDEX_FILE" ] || die "no $INDEX_FILE at $store (run: project-memory init)"
  before_idx=$(cat "$store/$INDEX_FILE")
  before_files=$(cat "$store/$FILES_FILE" 2>/dev/null || printf '')
  cmd_index > /dev/null
  if [ "$before_idx" = "$(cat "$store/$INDEX_FILE")" ] && [ "$before_files" = "$(cat "$store/$FILES_FILE")" ]; then
    printf 'indexes up to date\n'
  else
    printf 'indexes were stale — regenerated (commit the result)\n' >&2
    exit 1
  fi
}

# Print `id<TAB>title` for every chunk matching a term (case-insensitive).
#
# Searches chunk bodies, not just the index, because the answer to "what do we
# know about X" is usually in a Why or Evidence line rather than a title.
cmd_find() {
  local term="${1:-}"; [ -n "$term" ] || die 'usage: project-memory find <term>'
  local store p; store=$(store_dir)
  grep -ril --include='*.md' -- "$term" "$store" 2>/dev/null \
    | LC_ALL=C sort -r \
    | while IFS= read -r p; do
        # Skip the generated files: they contain every title, so leaving them in
        # would make each match appear twice with the wrong id.
        case "$(basename "$p")" in "$INDEX_FILE"|"$FILES_FILE") continue ;; esac
        printf '%s\t%s\n' "$(field "$p" "$FM_ID")" "$(field "$p" "$FM_TITLE")"
      done
}

# Print the FILES.md rows naming a path — the recall step to run before editing
# a file. Substring match, so passing a directory finds chunks about anything
# beneath it.
cmd_files() {
  local path="${1:-}"; [ -n "$path" ] || die 'usage: project-memory files <path>'
  local store; store=$(store_dir)
  grep -F -- "$path" "$store/$FILES_FILE" 2>/dev/null || printf 'no chunks recorded for %s\n' "$path"
}

# Usage text. Kept in sync by hand with the command table in SKILL.md.
cmd_help() {
  cat <<EOF
project-memory — helper for a satl-project-memory store ($STORE_REL/)

  project-memory init                    create the store and empty indexes
  project-memory new <type> "<title>"    create today's next chunk from the template
  project-memory index                   regenerate $INDEX_FILE and $FILES_FILE
  project-memory check                   non-zero exit if the indexes had drifted
  project-memory find <term>             chunks matching a term (id + title)
  project-memory files <path>            chunks that mention a file path
  project-memory help                    this text

Types: $VALID_TYPES
Env:   MEMORY_DIR overrides store location (default: nearest $STORE_REL)
EOF
}

case "${1:-help}" in
  init)  shift; cmd_init "$@" ;;
  new)   shift; cmd_new "$@" ;;
  index) shift; cmd_index "$@" ;;
  check) shift; cmd_check "$@" ;;
  find)  shift; cmd_find "$@" ;;
  files) shift; cmd_files "$@" ;;
  help|-h|--help) cmd_help ;;
  *) die "unknown command '$1' (try: project-memory help)" ;;
esac
